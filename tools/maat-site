#!/usr/bin/env python3
"""Maât site scaffold. Does not alter running services or privilege boundaries."""
import argparse
import os
import pathlib
import re
import shutil
import sys
import stat

ROOT = pathlib.Path(__file__).resolve().parent.parent
TEMPLATE = ROOT / 'examples' / 'maat-site' / 'public'


def create(name, destination):
    if not re.fullmatch(r'[a-z][a-z0-9-]{0,62}', name) or name.endswith('-'):
        raise ValueError('site name must be lowercase DNS-like text (1-63 chars)')
    base = pathlib.Path(destination)
    if base.is_symlink():
        raise ValueError('destination parent cannot be a symlink')
    base = base.resolve(strict=True)
    if not base.is_dir():
        raise ValueError('destination parent must be a directory')
    target = base / name
    if target.exists() or target.is_symlink():
        raise FileExistsError(f'refusing to overwrite {target}')
    # Refuse partially completed scaffolds rather than silently repairing them.
    target.mkdir(mode=0o755)
    try:
        (target / 'public').mkdir(mode=0o755)
        (target / 'private').mkdir(mode=0o700)
        for src in TEMPLATE.iterdir():
            if not src.is_file() or src.is_symlink():
                raise ValueError('unexpected template entry')
            shutil.copyfile(src, target / 'public' / src.name)
            (target / 'public' / src.name).chmod(0o644)
        (target / 'private' / 'README.txt').write_text('Non-public application data. Do not serve this directory.\n', encoding='utf-8')
        (target / 'private' / 'README.txt').chmod(0o600)
        (target / 'apache-private.conf.example').write_text(
            '# FRAGMENT ONLY: for an already secured, dedicated Apache instance.\n'
            '# Not a standalone Apache config; do NOT include in public vhosts.\n'
            '# Check matching SSH bridge/broker loopback listener configuration.\n'
            'MaatIngress On\n'
            f'DocumentRoot "{target}/public"\n'
            f'<Directory "{target}/public">\n'
            '    Require all granted\n'
            '    AllowOverride None\n'
            '    Options -Indexes -FollowSymLinks -Includes -ExecCGI\n'
            '</Directory>\n'
            f'<Directory "{target}/private">\n'
            '    Require all denied\n'
            '</Directory>\n', encoding='utf-8')
        (target / 'apache-private.conf.example').chmod(0o600)
    except BaseException:
        shutil.rmtree(target)
        raise
    return target




def validated_site(name, destination):
    if not re.fullmatch(r'[a-z][a-z0-9-]{0,62}', name) or name.endswith('-'):
        raise ValueError('invalid site name')
    base = pathlib.Path(destination)
    if base.is_symlink():
        raise ValueError('root must not be a symbolic link')
    base = base.resolve(strict=True)
    site = base / name
    for item in (site, site / 'public', site / 'private'):
        if item.is_symlink() or not item.is_dir():
            raise ValueError(f'missing or symbolic-link directory: {item}')
    if site.stat().st_mode & stat.S_IWOTH or (site / 'public').stat().st_mode & stat.S_IWOTH:
        raise ValueError('site and public directory must not be world-writable')
    if (site / 'private').stat().st_mode & 0o077:
        raise ValueError('private directory must be accessible only to owner')
    for part in (site / 'public').iterdir():
        if part.is_symlink():
            raise ValueError('public directory contains symbolic link')
    return site


def private_apache_config(site, port, module, php_module, user, group, runtime):
    # All interpolated values are validated; no arbitrary Apache directives.
    if not isinstance(port, int) or not 1024 <= port <= 65535:
        raise ValueError('port must be 1024..65535')
    for value in (str(site), str(module), str(php_module), str(runtime)):
        if any(ch in value for ch in '\n\r\"'):
            raise ValueError('unsafe configuration path')
    for value in (user, group):
        if not re.fullmatch(r'[a-z_][a-z0-9_-]*', value):
            raise ValueError('invalid service user or group')
    for lib in (module, php_module):
        lib = pathlib.Path(lib)
        if not lib.is_file() or lib.is_symlink():
            raise ValueError(f'missing or unsafe Apache module: {lib}')
    runtime = pathlib.Path(runtime)
    if runtime.is_symlink() or not runtime.is_dir():
        raise ValueError('runtime directory must exist and not be a symlink')
    return f"""# Generated by maat-site. DO NOT INCLUDE in system Apache.
# Dedicated Apache configuration; SSH bridge and broker are separate services.
ServerRoot /etc/apache2
ServerName 127.0.0.1
Listen 127.0.0.1:{port}
PidFile "{runtime}/apache.pid"
ErrorLog "{runtime}/apache-error.log"
LogLevel warn
LoadModule mpm_prefork_module /usr/lib/apache2/modules/mod_mpm_prefork.so
LoadModule authz_core_module /usr/lib/apache2/modules/mod_authz_core.so
LoadModule php_module "{php_module}"
LoadModule maat_module "{module}"
MaatIngress On
User {user}
Group {group}
DocumentRoot "{site}/public"
<Directory "{site}/public">
    Require all granted
    AllowOverride None
    Options -Indexes -FollowSymLinks -Includes -ExecCGI
    <FilesMatch "\\.php$">
        SetHandler application/x-httpd-php
    </FilesMatch>
</Directory>
<Directory "{site}/private">
    Require all denied
</Directory>
"""


def deploy(name, destination, output, port, module, php_module, user, group, runtime):
    site = validated_site(name, destination)
    out = pathlib.Path(output)
    if out.exists() or out.is_symlink():
        raise FileExistsError(f'configuration already exists: {out}')
    if out.parent.is_symlink() or not out.parent.is_dir():
        raise ValueError('configuration parent must be a real directory')
    config = private_apache_config(site, port, module, php_module, user, group, runtime)
    # O_EXCL prevents overwriting existing configurations or symlinks.
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(config)
    except BaseException:
        out.unlink(missing_ok=True)
        raise
    return out


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest='command', required=True)
    p = subs.add_parser('create', help='create site files; NEVER activate Apache automatically')
    p.add_argument('name')
    p.add_argument('--root', default='/var/www/maat', help='existing parent directory (default: /var/www/maat)')
    c = subs.add_parser('check', help='validate a site without modifying anything')
    c.add_argument('name')
    c.add_argument('--root', default='/var/www/maat')
    d = subs.add_parser('deploy', help='write an isolated Apache config; NEVER activate it')
    d.add_argument('name')
    d.add_argument('--root', default='/var/www/maat')
    d.add_argument('--output', required=True, help='new configuration file, never overwritten')
    d.add_argument('--port', type=int, default=18082)
    d.add_argument('--maat-module', required=True)
    d.add_argument('--php-module', required=True)
    d.add_argument('--user', default='www-data')
    d.add_argument('--group', default='www-data')
    d.add_argument('--runtime', required=True, help='existing isolated writable runtime directory')
    args = parser.parse_args()
    try:
        if args.command == 'create':
            dest = create(args.name, args.root)
        elif args.command == 'check':
            dest = validated_site(args.name, args.root)
            print(f'PASS site structure and permissions: {dest}')
            return
        else:
            dest = deploy(args.name, args.root, args.output, args.port,
                          args.maat_module, args.php_module, args.user,
                          args.group, args.runtime)
            print(f'Staged {dest} (NOT activated). Run apache2 -t -f {dest}')
            return
    except (OSError, ValueError) as exc:
        parser.exit(2, f'maat-site: {exc}\n')
    print(f'Created {dest} (no services or vhosts enabled)')
    print(f'Review {dest}/apache-private.conf.example before configuring a DEDICATED Apache instance')


if __name__ == '__main__':
    main()
