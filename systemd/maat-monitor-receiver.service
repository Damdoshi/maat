[Unit]
Description=Maât privileged OpenSSH authentication receiver
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/sbin/maat-monitor-receiver
User=root
Group=root
RuntimeDirectory=maat
RuntimeDirectoryMode=0700
StateDirectory=maat
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/maat /var/lib/maat
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
